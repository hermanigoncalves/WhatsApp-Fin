{
  "buildCommand": "npm install && cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/whatsapp/instances/connect", "destination": "https://whatsapp-fin.onrender.com/connect" },
    { "source": "/api/whatsapp/instances/status", "destination": "https://whatsapp-fin.onrender.com/health" },
    { "source": "/((?!api/).*)", "destination": "/" }
  ]
}
